
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Affinity Ads</title>
  <style>
    *{box-sizing:border-box}
    body{margin:0;font-family:Arial,sans-serif;background:#f4f6fb;color:#182033}
    header{background:#14264b;color:white;padding:22px 16px;text-align:center}
    header h1{margin:0;font-size:29px}
    header p{margin:7px 0 0;color:#d9e4ff}
    main{max-width:900px;margin:20px auto;padding:0 14px}
    section{background:white;padding:18px;margin-bottom:16px;border-radius:13px;box-shadow:0 2px 10px #0000000c}
    h2{margin:0 0 14px;font-size:20px}
    input,select,textarea{width:100%;padding:12px;margin:6px 0 12px;border:1px solid #ccd3df;border-radius:8px;font-size:15px}
    textarea{min-height:90px}
    button{background:#2455c5;color:white;border:0;border-radius:8px;padding:12px 16px;font-size:15px;font-weight:bold;cursor:pointer;margin:4px 3px 4px 0}
    button.secondary{background:#e8edfa;color:#19366e}
    button.danger{background:#a52d38}
    .muted{color:#68748a;font-size:14px}
    .hidden{display:none}
    .tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
    .ad{border:1px solid #e1e6ef;border-radius:10px;padding:14px;margin:12px 0}
    .ad h3{margin:0 0 8px}
    .ad img{max-width:100%;max-height:230px;object-fit:cover;border-radius:8px}
    .price{font-weight:bold;color:#1749a5}
    #message{padding:10px;border-radius:8px;margin:10px 0;background:#edf3ff}
    footer{text-align:center;padding:20px;color:#68748a;font-size:13px}
  </style>
</head>
<body>
<header>
  <h1>Affinity Ads</h1>
  <p>Promote your products, services, jobs and businesses.</p>
</header>

<main>
  <div id="message">Welcome to Affinity Ads.</div>

  <section id="account">
    <h2>Your account</h2>
    <div class="tabs">
      <button onclick="showAccount('signup')">Create account</button>
      <button class="secondary" onclick="showAccount('login')">Sign in</button>
    </div>
    <form id="accountForm">
      <input id="fullName" placeholder="Your full name">
      <input id="email" type="email" placeholder="Email address" required>
      <input id="password" type="password" placeholder="Password (at least 6 characters)" required>
      <button id="accountButton" type="submit">Create account</button>
    </form>
    <p class="muted">Create an account to publish adverts and manage your listings.</p>
  </section>

  <section id="profile" class="hidden">
    <h2>Welcome, <span id="userEmail"></span></h2>
    <button class="danger" onclick="signOut()">Sign out</button>
  </section>

  <section id="postSection" class="hidden">
    <h2>Post an advert</h2>
    <form id="listingForm">
      <input id="title" placeholder="Advert title" required>
      <select id="category" required>
        <option value="">Choose category</option>
        <option>Products</option>
        <option>Services</option>
        <option>Jobs</option>
        <option>Businesses</option>
        <option>Property</option>
        <option>Vehicles</option>
        <option>Events</option>
        <option>Other</option>
      </select>
      <textarea id="description" placeholder="Describe your advert" required></textarea>
      <input id="price" placeholder="Price (optional)">
      <select id="currency">
        <option>USD</option><option>ZWG</option><option>ZAR</option>
        <option>GBP</option><option>Other</option>
      </select>
      <input id="location" placeholder="Your town or location">
      <input id="imageUrl" type="url" placeholder="Image URL (optional)">
      <button type="submit">Submit advert</button>
    </form>
    <p class="muted">Adverts may need approval before appearing publicly.</p>
  </section>

  <section>
    <h2>Explore adverts</h2>
    <input id="search" placeholder="Search adverts..." oninput="renderListings()">
    <select id="filter" onchange="renderListings()">
      <option value="">All categories</option>
      <option>Products</option><option>Services</option><option>Jobs</option>
      <option>Businesses</option><option>Property</option><option>Vehicles</option>
      <option>Events</option><option>Other</option>
    </select>
    <div id="listings"><p class="muted">Loading adverts...</p></div>
  </section>
</main>

<footer>Affinity Ads · Connecting people with opportunities</footer>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="config.js"></script>
<script>
let db;
let currentUser = null;
let allListings = [];
let accountMode = "signup";

function message(text) {
  document.getElementById("message").textContent = text;
}

function showAccount(mode) {
  accountMode = mode;
  document.getElementById("accountButton").textContent =
    mode === "signup" ? "Create account" : "Sign in";
  document.getElementById("fullName").classList.toggle("hidden", mode === "login");
}

function escapeHTML(value) {
  return String(value ?? "").replace(/[&<>"']/g, c => ({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
  }[c]));
}

async function startApp() {
  if (!window.supabase || !window.SUPABASE_URL || !window.SUPABASE_ANON_KEY) {
    message("Connection settings are missing. Please check config.js.");
    return;
  }

  db = window.supabase.createClient(
    window.SUPABASE_URL,
    window.SUPABASE_ANON_KEY
  );

  const { data } = await db.auth.getSession();
  currentUser = data.session ? data.session.user : null;
  updateAccount();
  await loadListings();

  db.auth.onAuthStateChange((_event, session) => {
    currentUser = session ? session.user : null;
    updateAccount();
    loadListings();
  });
}

function updateAccount() {
  document.getElementById("account").classList.toggle("hidden", !!currentUser);
  document.getElementById("profile").classList.toggle("hidden", !currentUser);
  document.getElementById("postSection").classList.toggle("hidden", !currentUser);
  document.getElementById("userEmail").textContent =
    currentUser ? currentUser.email : "";
}

document.getElementById("accountForm").addEventListener("submit", async e => {
  e.preventDefault();
  if (!db) return message("The app is not connected to Supabase.");

  const email = document.getElementById("email").value.trim();
  const password = document.getElementById("password").value;
  const fullName = document.getElementById("fullName").value.trim();

  message("Please wait...");

  if (accountMode === "signup") {
    if (!fullName) return message("Please enter your full name.");
    const { data, error } = await db.auth.signUp({
      email, password,
      options: { data: { full_name: fullName } }
    });
    if (error) return message(error.message);

    if (data.user && data.session) {
      await db.from("profiles").upsert({
        id: data.user.id, full_name: fullName
      });
      message("Your account has been created!");
    } else {
      message("Registration received. Check your email to confirm your account, then sign in.");
    }
  } else {
    const { error } = await db.auth.signInWithPassword({ email, password });
    if (error) return message(error.message);
    message("You are signed in!");
  }
});

async function signOut() {
  const { error } = await db.auth.signOut();
  if (error) message(error.message);
  else message("You have signed out.");
}

document.getElementById("listingForm").addEventListener("submit", async e => {
  e.preventDefault();
  if (!currentUser) return message("Please sign in first.");

  const advert = {
    owner_id: currentUser.id,
    title: document.getElementById("title").value.trim(),
    category: document.getElementById("category").value,
    description: document.getElementById("description").value.trim(),
    price: document.getElementById("price").value.trim() || null,
    currency: document.getElementById("currency").value,
    location: document.getElementById("location").value.trim(),
    image_url: document.getElementById("imageUrl").value.trim() || null,
    status: "pending"
  };

  message("Submitting your advert...");
  const { error } = await db.from("listings").insert(advert);
  if (error) return message(error.message);

  e.target.reset();
  message("Advert submitted! It will appear publicly after approval.");
  await loadListings();
});

async function loadListings() {
  if (!db) return;
  const { data, error } = await db.from("listings")
    .select("*").order("created_at", { ascending: false });

  if (error) {
    document.getElementById("listings").textContent = error.message;
    return;
  }
  allListings = data || [];
  renderListings();
}

function renderListings() {
  const search = document.getElementById("search").value.toLowerCase();
  const category = document.getElementById("filter").value;

  const visible = allListings.filter(ad => {
    const isApproved = ad.status === "approved";
    const isMine = currentUser && ad.owner_id === currentUser.id;
    const matchesSearch =
      (ad.title + " " + ad.description + " " + (ad.location || ""))
      .toLowerCase().includes(search);
    return (isApproved || isMine) &&
      (!category || ad.category === category) && matchesSearch;
  });

  const container = document.getElementById("listings");
  if (!visible.length) {
    container.innerHTML = "<p class='muted'>No adverts found. Try another search.</p>";
    return;
  }

  container.innerHTML = visible.map(ad => `
    <article class="ad">
      <h3>${escapeHTML(ad.title)}</h3>
      <p class="muted">${escapeHTML(ad.category)} · ${escapeHTML(ad.location || "Location not specified")}</p>
      ${ad.image_url ? `<img src="${escapeHTML(ad.image_url)}" alt="Advert image" onerror="this.style.display='none'">` : ""}
      <p>${escapeHTML(ad.description)}</p>
      ${ad.price ? `<p class="price">${escapeHTML(ad.currency)} ${escapeHTML(ad.price)}</p>` : ""}
      ${ad.status !== "approved" ? "<p class='muted'>Your advert is awaiting approval.</p>" : ""}
    </article>
  `).join("");
}

startApp();
</script>
</body>
</html>
